diff --git a/build.sbt b/build.sbt
new file mode 100644
index 00000000..05822002
--- /dev/null
+++ b/build.sbt
@@ -0,0 +1,23 @@
+scalaVersion := "2.13.16"
+
+enablePlugins(ScalaJSPlugin)
+
+name := "feel-engine"
+
+// Scala.js compatible dependencies only (%%% = cross-compiled for Scala.js)
+libraryDependencies += "org.scala-js" %%% "scalajs-dom" % "2.8.0"
+libraryDependencies += "com.lihaoyi" %%% "fastparse" % "3.1.1"
+libraryDependencies += "io.github.cquiroz" %%% "scala-java-time" % "2.5.0"
+
+// Removed JVM-only dependencies (not used in source, incompatible with Scala.js):
+//   - org.slf4j % slf4j-api (JVM only)
+//   - com.fasterxml.uuid % java-uuid-generator (JVM only)
+//   - com.fasterxml.jackson.module %% jackson-module-scala (JVM only)
+//   - com.fasterxml.jackson.core % jackson-databind (JVM only)
+
+// Produce an ES module for easy integration with Vite/browser bundlers
+// ES2018 is needed for lookbehind regex in the FEEL parser
+scalaJSLinkerConfig ~= {
+  _.withModuleKind(ModuleKind.ESModule)
+   .withESFeatures(_.withESVersion(org.scalajs.linker.interface.ESVersion.ES2018))
+}
